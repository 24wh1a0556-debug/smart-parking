{
  "name": "smart-parking-backend",
  "version": "1.0.0",
  "description": "Smart Parking Management System - Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "db:migrate": "ts-node src/database/migrate.ts",
    "db:seed": "ts-node src/database/seed.ts"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.18.3",
    "express-validator": "7.0.1",
    "helmet": "7.1.0",
    "jsonwebtoken": "9.0.2",
    "node-cron": "3.0.3",
    "pg": "8.11.3",
    "prom-client": "15.1.2",
    "qrcode": "1.5.3",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.12",
    "@types/jsonwebtoken": "9.0.6",
    "@types/node": "20.11.30",
    "@types/node-cron": "3.0.11",
    "@types/pg": "8.11.3",
    "@types/qrcode": "1.5.5",
    "@types/uuid": "9.0.8",
    "jest": "29.7.0",
    "ts-jest": "29.1.2",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.4.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.ts", "**/*.test.ts"]
  }
}
