# ============================================================
# Smart Parking Management System - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- Backend ----
NODE_ENV=development
PORT=5000

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_parking
DB_USER=postgres
DB_PASSWORD=your_db_password

# CORS
CORS_ORIGIN=http://localhost:3000

# ---- Frontend ----
VITE_API_URL=http://localhost:5000/api

# Google Maps JavaScript API key — required for the Parking Map page
# Get one at: https://console.cloud.google.com/apis/credentials
# Enable: Maps JavaScript API
# Restrict by: HTTP referrers (your domain) for production
VITE_GOOGLE_MAPS_API_KEY=AIzaSyDTZE34XwuI-MgJUEcEqZ7Q1rYlmCd-WYI

# ---- Monitoring ----
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin123
